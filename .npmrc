# Izinkan build scripts untuk deps native (Prisma, esbuild, sharp, unrs-resolver).
# Nonaktifkan strict-dep-builds agar ERR_PNPM_IGNORED_BUILDS tidak menggagalkan install.
# Lihat https://pnpm.io/settings#onlybuiltdependencies
only-built-dependencies[]=@prisma/client
only-built-dependencies[]=@prisma/engines
only-built-dependencies[]=esbuild
only-built-dependencies[]=prisma
only-built-dependencies[]=sharp
only-built-dependencies[]=unrs-resolver
strict-dep-builds=false