# Hillside Eden - Environment Variables (contoh, aman di-commit)
# Salin ke .env atau .env.local lalu isi nilai yang sesuai.
# JANGAN commit file .env (sudah di-gitignore).

# --- Database (Neon) ---
# Lihat docs/briefs/od-01-neon-branches.md dan ADR-014.
# Salin dari tab Connect di Neon Console. JANGAN commit kredensial asli.
#
# DATABASE_URL = app runtime, endpoint POOLED (host mengandung "-pooler").
#   - connection_limit=5 -> Prisma opened 5x itu dalam pool (2-3 cukup juga).
#   - connect_timeout=15 -> wajib, compute Neon scale-to-zero butuh ~1 detik bangun.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/hillside_eden?sslmode=require&connection_limit=5&pool_timeout=15&connect_timeout=15
#
# DIRECT_DATABASE_URL = Prisma CLI (migrate/studio/introspect), endpoint DIRECT
# (tanpa "-pooler"). WAJIB ada karena schema.prisma memakai `directUrl`, termasuk
# saat `prisma validate` berjalan di CI.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/hillside_eden?sslmode=require&connect_timeout=15
#
# Opsional: set di environment produksi agar prisma/seed-dummy.ts menolak jalan
# bila DATABASE_URL menunjuk branch `main`.
# PROD_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/hillside_eden?sslmode=require&connection_limit=5&pool_timeout=15&connect_timeout=15
#
# --- Fallback Docker lokal (opsional) ---
# Bila Neon tak terjangkau dan Docker Desktop hidup, ganti kedua URL di atas dengan:
#   postgresql://hillside:hillside@localhost:5433/hillside_eden?schema=public
# (port 5433 di host untuk menghindari konflik dengan PostgreSQL 17 lokal di Windows)

# --- Aplikasi ---
APP_BASE_URL="http://localhost:3000"
NODE_ENV="development"
TZ="Asia/Makassar"

## --- Autentikasi (Auth.js, S1-03) ---
# Wajib base64 string minimal 32 byte. Hasil dari:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# WAJIB di-set di produksi. Untuk dev lokal, seed akan menggunakan default
# dan aplikasi akan memberi peringatan.
AUTH_SECRET="ganti-dengan-base64-32byte-hasil-openssl-rand-base64-32"

## --- User owner (di-seed oleh prisma/seed.ts, S1-03) ---
# ENV berikut mengganti default development `owner@hillside.local /
# he-dev-2026!`. Password minimal 8 karakter.
# - Di produksi: set OWNER_EMAIL ke email asli, OWNER_PASSWORD ke
#   password kuat (akan di-hash argon2id), dan set AUTH_SECRET.
OWNER_EMAIL="owner@hillside.local"
OWNER_PASSWORD="he-dev-2026!"

# --- Enkripsi (untuk URL iCal) ---
# ENCRYPTION_KEY="isi-dengan-openssl-rand-hex-32"

# --- Penyimpanan (default lokal) ---
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"

# --- Email masuk (antarmuka, implementasi menyusul Sprint 5) ---
INBOUND_EMAIL_DRIVER="none"

# --- Worker ---
WORKER_ENABLED="true"